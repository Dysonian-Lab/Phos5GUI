{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Phosphor 2.2 GUI",
  "version": "2.2.1",
  "identifier": "com.phosphor.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Phosphor 2.2 GUI",
        "width": 1200,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600,
        "decorations": true,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' asset: https://asset.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "externalBin": [
      "binaries/proxmark3"
    ],
    "resources": {
      "binaries/proxmark3/*.dll": "./binaries/proxmark3/",
      "firmware/pm5/standard/bootrom.elf": "./firmware/pm5/standard/",
      "firmware/pm5/standard/fullimage.elf": "./firmware/pm5/standard/",
      "firmware/pm5/bwm/bootrom.elf": "./firmware/pm5/bwm/",
      "firmware/pm5/bwm/fullimage.elf": "./firmware/pm5/bwm/",
      "firmware/pm5/fpga_bitstream.bin": "./firmware/pm5/",
      "capabilities/pm5.json": "./capabilities/pm5.json"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "copyright": "Copyright 2025-2026 nik shuv",
    "shortDescription": "Proxmark3 GUI for one-click card cloning",
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "displayLanguageSelector": true,
        "languages": [
          "English",
          "Russian"
        ],
        "installerIcon": "icons/icon.ico"
      }
    }
  }
}
